{"entryType":"UniProtKB reviewed (Swiss-Prot)","primaryAccession":"A2BWS5","uniProtkbId":"GATA_PROM5","entryAudit":{"firstPublicDate":"2008-01-15","lastAnnotationUpdateDate":"2026-09-02","lastSequenceUpdateDate":"2007-02-20","entryVersion":93,"sequenceVersion":1},"annotationScore":3.0,"organism":{"scientificName":"Prochlorococcus marinus (strain MIT 9515)","taxonId":167542,"lineage":["Bacteria","Bacillati","Cyanobacteriota","Cyanophyceae","Synechococcales","Prochlorococcaceae","Prochlorococcus"]},"proteinExistence":"3: Inferred from homology","proteinDescription":{"recommendedName":{"fullName":{"evidences":[{"evidenceCode":"ECO:0000255","source":"HAMAP-Rule","id":"MF_00120"}],"value":"Aspartyl/glutamyl-tRNA(Asn/Gln) amidotransferase subunit A"},"shortNames":[{"evidences":[{"evidenceCode":"ECO:0000255","source":"HAMAP-Rule","id":"MF_00120"}],"value":"Asp/Glu-ADT subunit A"}],"ecNumbers":[{"evidences":[{"evidenceCode":"ECO:0000255","source":"HAMAP-Rule","id":"MF_00120"}],"value":"3.5.1.2"}]},"alternativeNames":[{"fullName":{"evidences":[{"evidenceCode":"ECO:0000255","source":"HAMAP-Rule","id":"MF_00120"}],"value":"Glutamyl-tRNA(Gln) amidotransferase subunit A"},"shortNames":[{"evidences":[{"evidenceCode":"ECO:0000255","source":"HAMAP-Rule","id":"MF_00120"}],"value":"Glu-ADT subunit A"}]}]},"genes":[{"geneName":{"evidences":[{"evidenceCode":"ECO:0000255","source":"HAMAP-Rule","id":"MF_00120"}],"value":"gatA"},"orderedLocusNames":[{"value":"P9515_10291"}]}],"comments":[{"texts":[{"evidences":[{"evidenceCode":"ECO:0000255","source":"HAMAP-Rule","id":"MF_00120"}],"value":"Catalytic subunit of the Asp/Glu-tRNA(Asn/Gln) amidotransferase complex GatCAB. GatCAB allows the formation of correctly charged Asn-tRNA(Asn) or Gln-tRNA(Gln) through the multi-step transamidation of misacylated Asp-tRNA(Asn) or Glu-tRNA(Gln) in organisms which lack either or both of asparaginyl-tRNA or glutaminyl-tRNA synthetases. The reaction takes place in the presence of glutamine and ATP through an activated phospho-Asp-tRNA(Asn) or phospho-Glu-tRNA(Gln). This subunit catalyzes the hydrolysis of the amido donor Gln, releasing ammonia that is sequestered within a channel in the GatCAB complex and made available to subunit B for downstream aminolysis of Glu-tRNA(Gln); may also be able to use Asn as the amido donor"}],"commentType":"FUNCTION"},{"commentType":"CATALYTIC ACTIVITY","reaction":{"name":"L-glutamine + H2O = L-glutamate + NH4(+)","reactionCrossReferences":[{"database":"Rhea","id":"RHEA:15889"},{"database":"ChEBI","id":"CHEBI:15377"},{"database":"ChEBI","id":"CHEBI:28938"},{"database":"ChEBI","id":"CHEBI:29985"},{"database":"ChEBI","id":"CHEBI:58359"}],"ecNumber":"3.5.1.2","evidences":[{"evidenceCode":"ECO:0000255","source":"HAMAP-Rule","id":"MF_00120"}]}},{"texts":[{"evidences":[{"evidenceCode":"ECO:0000255","source":"HAMAP-Rule","id":"MF_00120"}],"value":"Component of the heterotrimeric GatCAB glutamyl-tRNA(Gln) amidotransferase complex composed of GatA, GatB and GatC"}],"commentType":"SUBUNIT"},{"texts":[{"evidences":[{"evidenceCode":"ECO:0000255","source":"HAMAP-Rule","id":"MF_00120"}],"value":"Belongs to the amidase family. GatA subfamily"}],"commentType":"SIMILARITY"}],"features":[{"type":"Chain","location":{"start":{"value":1,"modifier":"EXACT"},"end":{"value":484,"modifier":"EXACT"}},"description":"Aspartyl/glutamyl-tRNA(Asn/Gln) amidotransferase subunit A","featureId":"PRO_1000015883"},{"type":"Active site","location":{"start":{"value":74,"modifier":"EXACT"},"end":{"value":74,"modifier":"EXACT"}},"description":"Charge relay system","evidences":[{"evidenceCode":"ECO:0000255","source":"HAMAP-Rule","id":"MF_00120"}]},{"type":"Active site","location":{"start":{"value":149,"modifier":"EXACT"},"end":{"value":149,"modifier":"EXACT"}},"description":"Charge relay system","evidences":[{"evidenceCode":"ECO:0000255","source":"HAMAP-Rule","id":"MF_00120"}]},{"type":"Active site","location":{"start":{"value":173,"modifier":"EXACT"},"end":{"value":173,"modifi