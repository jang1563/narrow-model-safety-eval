{"entryType":"UniProtKB reviewed (Swiss-Prot)","primaryAccession":"Q63081","secondaryAccessions":["Q641Y3"],"uniProtkbId":"PDIA6_RAT","entryAudit":{"firstPublicDate":"1997-11-01","lastAnnotationUpdateDate":"2026-09-02","lastSequenceUpdateDate":"2005-03-29","entryVersion":178,"sequenceVersion":2},"annotationScore":5.0,"organism":{"scientificName":"Rattus norvegicus","commonName":"Rat","taxonId":10116,"lineage":["Eukaryota","Metazoa","Chordata","Craniata","Vertebrata","Euteleostomi","Mammalia","Eutheria","Euarchontoglires","Glires","Rodentia","Myomorpha","Muroidea","Muridae","Murinae","Rattus"]},"proteinExistence":"1: Evidence at protein level","proteinDescription":{"recommendedName":{"fullName":{"value":"Protein disulfide-isomerase A6"},"ecNumbers":[{"evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"Q15084"}],"value":"5.3.4.1"}]},"alternativeNames":[{"fullName":{"value":"Calcium-binding protein 1"},"shortNames":[{"value":"CaBP1"}]},{"fullName":{"value":"Protein disulfide isomerase P5"}},{"fullName":{"value":"Thioredoxin domain-containing protein 7"}}],"flag":"Precursor"},"genes":[{"geneName":{"value":"Pdia6"},"synonyms":[{"value":"Cabp1"},{"value":"Txndc7"}]}],"comments":[{"texts":[{"evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"Q15084"}],"value":"May function as a chaperone that inhibits aggregation of misfolded proteins. Negatively regulates the unfolded protein response (UPR) through binding to UPR sensors such as ERN1, which in turn inactivates ERN1 signaling. May also regulate the UPR via the EIF2AK3 UPR sensor. Plays a role in platelet aggregation and activation by agonists such as convulxin, collagen and thrombin"}],"commentType":"FUNCTION"},{"commentType":"CATALYTIC ACTIVITY","reaction":{"name":"Catalyzes the rearrangement of -S-S- bonds in proteins.","ecNumber":"5.3.4.1","evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"Q15084"}]}},{"texts":[{"evidences":[{"evidenceCode":"ECO:0000250","source":"U