{"entryType":"UniProtKB reviewed (Swiss-Prot)","primaryAccession":"V5YM14","uniProtkbId":"DAPB2_PSEMX","entryAudit":{"firstPublicDate":"2015-06-24","lastAnnotationUpdateDate":"2026-09-02","lastSequenceUpdateDate":"2014-02-19","entryVersion":42,"sequenceVersion":1},"annotationScore":5.0,"organism":{"scientificName":"Pseudoxanthomonas mexicana","taxonId":128785,"lineage":["Bacteria","Pseudomonadati","Pseudomonadota","Gammaproteobacteria","Lysobacterales","Lysobacteraceae","Pseudoxanthomonas"]},"proteinExistence":"1: Evidence at protein level","proteinDescription":{"recommendedName":{"fullName":{"evidences":[{"evidenceCode":"ECO:0000312","source":"EMBL","id":"BAO18427.1"}],"value":"Dipeptidyl aminopeptidase BII"},"shortNames":[{"evidences":[{"evidenceCode":"ECO:0000303","source":"PubMed","id":"24598890"},{"evidenceCode":"ECO:0000303","source":"PubMed","id":"8892831"}],"value":"DAP BII"}],"ecNumbers":[{"evidences":[{"evidenceCode":"ECO:0000269","source":"PubMed","id":"24598890"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"24637761"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"24827749"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"8892831"}],"value":"3.4.14.-"}]},"flag":"Precursor"},"genes":[{"geneName":{"evidences":[{"evidenceCode":"ECO:0000312","source":"EMBL","id":"BAO18427.1"}],"value":"dapb2"}}],"comments":[{"texts":[{"evidences":[{"evidenceCode":"ECO:0000269","source":"PubMed","id":"24598890"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"24827749"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"8892831"}],"value":"Exopeptidase that catalyzes the removal of dipeptide units (NH2-P2-P1-) from the free amino termini of oligopeptides and small proteins (PubMed:24598890, PubMed:24827749, PubMed:8892831). Peptide digestion is sequential and substrate recognition is non-specific, with the exception that Pro is not suitable as a P1 residue (PubMed:24827749). Removes many residues of bioactive oligopeptides such as angiotensin I 